diff --git a/OdbDesignLib/FileModel/Design/FileArchive.cpp b/OdbDesignLib/FileModel/Design/FileArchive.cpp
index 1212121..3434343 100644
--- a/OdbDesignLib/FileModel/Design/FileArchive.cpp
+++ b/OdbDesignLib/FileModel/Design/FileArchive.cpp
@@ -10,6 +10,22 @@
 #include <filesystem>
 
+static std::filesystem::path FindCaseInsensitive(
+    const std::filesystem::path& base,
+    const std::string& name)
+{
+    for (auto& p : std::filesystem::directory_iterator(base))
+    {
+        auto n = p.path().filename().string();
+        std::transform(n.begin(), n.end(), n.begin(), ::tolower);
+
+        std::string t = name;
+        std::transform(t.begin(), t.end(), t.begin(), ::tolower);
+
+        if (n == t)
+            return p.path();
+    }
+    return base / name;
+}
 
 bool FileArchive::Exists(...)
 {
@@ -55,7 +70,12 @@
 
     if (!std::filesystem::exists(path))
     {
-        return false;
+        if (OdbDesign::g_parser_options.case_insensitive_path)
+        {
+            path = FindCaseInsensitive(path.parent_path(), path.filename().string());
+            return std::filesystem::exists(path);
+        }
+        return false;
     }
 
     return true;

