+#pragma once
+
+namespace OdbDesign
+{
+
+struct ParserOptions
+{
+    bool altium_compat = true;
+
+    bool optional_attr = true;
+    bool optional_dcode = true;
+    bool optional_orient = true;
+    bool optional_mirror = true;
